# Copy to .env.local and fill in. Placeholders only: never put real values in this file.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
# must equal the API's ACCESS_TOKEN_SECRET (the proxy checks the access token)
ACCESS_TOKEN_SECRET=change-me

# optional: error tracking (off when empty)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# source map upload during the build (optional)
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
